{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["id", "label", "configDir", "nativeEntry", "renderDir", "skillsDir", "agentsDir", "agentFrontmatter"],
  "properties": {
    "id": { "type": "string", "enum": ["claude", "codex", "trae", "workbuddy", "qoder"] },
    "label": { "type": "string", "minLength": 1 },
    "configDir": { "type": "string", "minLength": 1 },
    "nativeEntry": { "type": "string", "minLength": 1 },
    "renderDir": { "type": "string", "minLength": 1 },
    "skillsDir": { "type": "string", "minLength": 1 },
    "agentsDir": { "type": ["string", "null"] },
    "agentFrontmatter": { "type": ["array", "null"], "items": { "type": "string" } }
  },
  "additionalProperties": false
}
