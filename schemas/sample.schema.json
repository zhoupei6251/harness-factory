{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://harness-factory/schemas/sample.schema.json",
  "type": "object",
  "required": [
    "schema_version",
    "id",
    "display_title",
    "template",
    "voice",
    "facts",
    "images",
    "scenes"
  ],
  "properties": {
    "schema_version": { "const": "1" },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$",
      "description": "sample 唯一主键 (kebab-case). 与 t001-coral / everest-stat 同形"
    },
    "display_title": {
      "type": "string",
      "minLength": 1,
      "description": "sample 展示标题 (脱敏后, 不含真人真地名)"
    },
    "template": {
      "type": "string",
      "enum": [
        "news-coral", "news-coral-mono", "news-mosaic", "news-dusk",
        "news-ink", "news-ink-graphite", "news-noir",
        "news-policy", "news-policy-bold", "news-paper",
        "news-stat", "news-stat-grid",
        "news-onsite", "news-onsite-urgent",
        "news-bulletin", "news-bulletin-strip",
        "news-explainer", "news-explainer-blueprint",
        "news-alert", "news-alert-warning",
        "news-thread", "news-thread-tribute",
        "news-takes", "news-takes-column", "news-podcast",
        "news-blast", "news-blast-score",
        "news-world", "news-world-globe",
        "news-polarity", "news-dawn"
      ],
      "description": "渲染 pack 名, 选自 32 个真模板 (ALL_TEMPLATES 现算, 详见 DESIGN-lsh.md §3.2.1)"
    },
    "voice": {
      "type": "string",
      "enum": [
        "zh-CN-XiaoxiaoNeural",
        "zh-CN-YunxiNeural",
        "zh-CN-YunyangNeural",
        "zh-CN-XiaoyiNeural",
        "zh-CN-YunjianNeural"
      ],
      "description": "edge-tts voice 名 (项目硬性只用 edge-tts, 零云费)"
    },
    "facts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["claim", "source_url", "source_label", "source_fingerprint_sha256"],
        "properties": {
          "claim": {
            "type": "string",
            "minLength": 1,
            "description": "事实声明 (脱敏后, 不含真人真地名 / 真部门)"
          },
          "source_url": {
            "type": "string",
            "format": "uri",
            "description": "事实来源 URL (Wikimedia 优先, 稳定; 不允许 example.com 占位)"
          },
          "source_label": {
            "type": "string",
            "minLength": 1,
            "description": "来源名 (e.g. '澎湃新闻', 'Wikimedia Commons', '新华社')"
          },
          "source_fingerprint_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$",
            "description": "source_url GET 内容的 sha256, 由 seed_sample_fingerprint.py 种子填入"
          }
        },
        "additionalProperties": false
      }
    },
    "images": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "scene_position",
          "wikimedia_url",
          "license_spdx",
          "credit",
          "source_fingerprint_sha256"
        ],
        "properties": {
          "scene_position": {
            "type": "integer",
            "minimum": 1,
            "description": "该图用于哪一镜 (1-based)"
          },
          "wikimedia_url": {
            "type": "string",
            "format": "uri",
            "description": "Wikimedia Commons File 页 URL (不上传本地副本, 引用稳定)"
          },
          "license_spdx": {
            "type": "string",
            "enum": ["CC0-1.0", "CC-BY-3.0", "CC-BY-4.0", "CC-BY-SA-3.0", "CC-BY-SA-4.0", "PD"],
            "description": "SPDX 标识的许可; PD 仅限极老摄影作品 (1949 前)"
          },
          "credit": {
            "type": "string",
            "minLength": 1,
            "description": "作者 + 来源 (e.g. 'Author Name (Wikimedia Commons)')"
          },
          "source_fingerprint_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "additionalProperties": false
      }
    },
    "scenes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["position", "layout", "kicker", "title", "body", "onscreen"],
        "properties": {
          "position": { "type": "integer", "minimum": 1 },
          "layout": {
            "type": "string",
            "enum": ["hook", "closer", "story", "stat", "quote", "catalog", "rail"],
            "description": "7 个 AUTO_LAYOUT_STEMS 之一 (DESIGN-lsh.md / path_b_build 同源)"
          },
          "kicker": { "type": "string", "minLength": 1 },
          "title": { "type": "string", "minLength": 1 },
          "body": { "type": "string", "minLength": 1 },
          "onscreen": {
            "type": "string",
            "minLength": 1,
            "description": "屏上文字 (含 '｜' 分隔标记语法, 见 routes/news/MEMORY.md §屏标)"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}