{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["name", "config_root"],
  "properties": {
    "name": { "type": "string", "enum": ["claude", "codex", "trae", "workbuddy"] },
    "config_root": { "type": "string", "minLength": 1 },
    "trust_model": { "type": "string", "enum": ["auto", "explicit", "approval"] },
    "hooks_supported": { "type": "boolean" },
    "mcp_supported": { "type": "boolean" }
  },
  "additionalProperties": false
}
