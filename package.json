{
  "name": "harness-factory",
  "version": "2.1.0",
  "description": "Harness v2.1 + foundry 整合：核心大脑 + foundry 全素材库（skills/ capabilities/ / routes/ / schemas/ / mcp-config/）+ v3 编排层（router/ workflows/ mcp/ agents/）。单实例；按路线渲染到 `.harness/`。",
  "private": true,
  "type": "module",
  "scripts": {
    "harness":  "node --experimental-strip-types scripts/bootstrap.ts",
    "check":    "node --experimental-strip-types scripts/validate.ts",
    "typecheck":"tsc --noEmit",
    "test":     "npm run harness && npm run check && npm run typecheck",
    "lint":     "node --experimental-strip-types scripts/lint-prompts.ts",
    "render":   "node --experimental-strip-types scripts/render.ts",
    "sync":     "node --experimental-strip-types scripts/sync-platforms.ts",
    "eval":     "node --experimental-strip-types scripts/evals-runner.ts"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}