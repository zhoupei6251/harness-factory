    "instinct": "node scripts/instinct-cli.js",
    "instinct:test": "node --test scripts/instinct-cli.test.js",
    "eval": "node scripts/eval/run-skill-eval.js --all"
  },
  "keywords": [
    "claude-code",
    "harness",
    "orchestration",
    "agents",
    "skills"
  ],
