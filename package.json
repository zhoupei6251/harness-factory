{
  "name": "harness-foundry",
  "version": "1.0.0",
  "description": "AI coding workflow framework for Claude Code - multi-agent orchestration system",
  "scripts": {
    "dashboard": "python3 scripts/dashboard/dashboard.py",
    "dashboard:win": "python scripts/dashboard/dashboard.py",
    "verify": "bash scripts/verify.sh",
    "bootstrap": "bash scripts/bootstrap.sh --target all",
